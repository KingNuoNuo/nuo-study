# =============================================================================
# 复制成 .env 再改：cp .env.example .env
#
# .env 已在 .gitignore 里 —— **密钥永远不要提交**。
# 留空 = 对应能力不可用（服务本身照常启动，/api/health 会如实报 false）。
# =============================================================================

# ---------------------------------------------------------------- 基础
# ⚠️ 这一项必须改。它是所有客户端连服务端的唯一凭证（单家庭部署，没有账号体系）。
#    生成一个随机串：python -c "import secrets;print(secrets.token_urlsafe(24))"
FAMILY_TOKEN=change-me-to-a-random-string

SERVER_HOST=0.0.0.0
SERVER_PORT=8092

# 单个上传文件上限（字节），默认 16MB
MAX_UPLOAD_BYTES=16777216

# ---------------------------------------------------------------- 作业识别（家长端拍照 → 结构化）
# 任意 OpenAI 兼容的多模态端点。推荐商汤 sensenova-6.8-flash-lite：
# 实测单张截图约 4,100 token，各维度准确率 100%（见 docs/recognition-eval.md）。
VISION_API_KEY=
VISION_BASE_URL=https://api.sensenova.cn/compatible-mode/v1
VISION_MODEL=sensenova-6.8-flash-lite
# ⚠️ 必须关思考。开着会把 max_tokens 吃光、返回空正文，而且错误很隐蔽
#    （HTTP 200 + 空 content）。详见 docs/recognition-eval.md。
VISION_THINKING=off
VISION_MAX_TOKENS=32000
VISION_TIMEOUT=180

# 识别 Worker（队列消费）
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL=1.0
WORKER_LEASE_SECONDS=300

# ---------------------------------------------------------------- 英语：语音合成（课文点读 / 示范音）
# 微软 Azure Speech。voice 换成 en-US-* 就变美音 —— 教材是英音，别随便换。
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastasia
AZURE_TTS_VOICE=en-GB-SoniaNeural
# 语速 / 音调（SSML prosody）。留空 = 原生。这两项直接影响「听着怪不怪」。
AZURE_TTS_RATE=-5%
AZURE_TTS_PITCH=

# ---------------------------------------------------------------- 英语：跟读评测
# 腾讯智聆（SOE）。不配则「跟读评测」按钮是灰的。
TENCENT_APP_ID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# ---------------------------------------------------------------- 英语：陪练对话 + 语音转写
# 阿里云百炼（千问）。对话与转写共用这一把 key。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-flash
# 转写引擎：http（推荐，3.8s 音频约 600ms）| realtime（官方 WS，同段音频约 6s）
QWEN_ASR_ENGINE=http
QWEN_ASR_HTTP_MODEL=qwen3-asr-flash
QWEN_ASR_MODEL=qwen3-asr-flash-realtime
QWEN_ASR_LANGUAGE=en
QWEN_ASR_MAX_SECONDS=60

# 没配千问时的备选转写（OpenAI）
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# 容器里自带 ffmpeg；裸进程部署要自己装
FFMPEG_BIN=ffmpeg

# ---------------------------------------------------------------- 家长端「实时画面」（可选）
# 走 adb 抓孩子平板屏幕。不配则只能用 App 自带的抓帧通道。
ADB_BIN=adb
ADB_TARGET=
ADB_INTERVAL=3.0
ADB_JPEG_QUALITY=60
ADB_MAX_WIDTH=1280
ADB_IDLE_STOP=30
