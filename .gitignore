# =============================================================================
# 本地环境与密钥 —— **绝不上传**
# =============================================================================
# .env 里是 Azure / 腾讯智聆 / 千问 / OpenAI 的真实密钥，泄露了要立刻轮换。
.env
.env.*
!.env.example
*.bak
*.bak.*

# 本机 Android SDK 路径 + 内置的服务端地址/家庭令牌（见 core-data/build.gradle.kts）
android/local.properties

# =============================================================================
# 运行时数据
# =============================================================================
# data/ 下是数据库、TTS 缓存、临时录音，每天在变，不入库。
# **但** data/english/pages 是教材逐页抽取的原始结果 —— 课程数据的源头，
# 不提交的话别人 clone 下来没法重建 curriculum.json。用「忽略父目录 + 例外」的写法。
data/*
!data/english/
data/english/*
!data/english/pages/

out/

# =============================================================================
# 构建产物
# =============================================================================
dist/
*.apk
*.aab

android/.gradle/
android/.kotlin/
android/build/
android/*/build/
android/.idea/
android/captures/

# 反编译 / 抓包 / 调试过程中落下的临时目录
# （踩过：44MB 的 .debug-shots 差点进仓库）
.debug-shots/
dex-*/
.tools/

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# =============================================================================
# 编辑器 / 系统
# =============================================================================
.vscode/
.DS_Store
Thumbs.db
*.swp

# =============================================================================
# ⚠️ 这些**必须提交**，别手贱加进忽略规则
# =============================================================================
# android/gradle/wrapper/gradle-wrapper.jar  —— 少了它 clone 下来没 wrapper，构建直接失败
# web/english/audio/*.mp3                  —— 40 段教材配套录音，81MB，是内容不是产物
# web/english/curriculum.json              —— 课程数据本体
# data/english/pages/*.json                —— 教材页抽取结果（课程数据的源头）

# =============================================================================
# 调试 / 逆向过程中的临时产物（不属于本项目，误落在仓库根目录）
# =============================================================================
_*.py
_*.png
_*.html
out_py_*.py
logcat-*.txt
shot-*.png

# buildSrc 自己的 gradle 缓存（android/.gradle 那条盖不到它）
android/buildSrc/.gradle/

# 截图（验收用的临时产物，不进仓库）
shot-*.jpg
samples/

# 安卓单测在工作目录生成的临时数据库残留
tmp-child-db*/
tmp-child.db

# 更多联调残留
tmp-ui.xml
tmp_merged.db*
tmp-student-current/
